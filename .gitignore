# ==============================
# Python general ignores
# ==============================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

*.pyc
*.pyo
*.DS_Store
*.zip
.vscode/
.idea/

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
env/
ENV/
.venv/
.python-version

# PyInstaller
# Usually creates a 'build' and 'dist' folder
# Include spec files only if necessary
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/

# Jupyter Notebook checkpoints
.ipynb_checkpoints

# IDE / Editor specific
.vscode/
.idea/
*.swp
*.swo
*.bak
*.tmp

# OS-specific
.DS_Store
Thumbs.db

# ==============================
# Project specific
# ==============================

# Assets (if you have big reference files or renders)
assets/tmp/
assets/cache/
assets/*.bak

# Backup or export files
*.csv~
*.bak
*.tmp
